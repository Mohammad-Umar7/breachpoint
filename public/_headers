# Cloudflare Pages / Netlify header rules. Copied verbatim into dist/ by Vite.
# Harmless on hosts that ignore it (Vercel reads vercel.json instead).

# Vite fingerprints these filenames, so the content behind a given URL can
# never change. Cache them forever — a returning player re-downloads nothing.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Model filenames are NOT fingerprinted (they live in public/), so they must be
# revalidated or a rebuilt weapon would never reach anyone who had already
# played. A day of caching with must-revalidate is the right trade.
/models/*
  Cache-Control: public, max-age=86400, must-revalidate

# The entry point must never be cached, or players get an old bundle pointing
# at asset hashes that no longer exist — which presents as a blank screen.
/index.html
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
